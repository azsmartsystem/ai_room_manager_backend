# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_room_manager

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-min-string
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-min-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_BROKER_URL=mqtts://broker.yourdomain.com:8883
MQTT_TLS_CA_CERT_PATH=./certs/ca.crt
MQTT_TLS_CLIENT_CERT_PATH=./certs/client.crt
MQTT_TLS_CLIENT_KEY_PATH=./certs/client.key

# ── Email (notifications) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=change-me
